# Copy to a private path outside Git, restrict access to the file, and fill only what you use.
# Values are literal KEY=value entries: no shell quotes and no `export` prefix.
# Empty or omitted integration credentials let `llmdv job` run with delivery skipped.

# S3 / S3-compatible object storage. Alternatively, use the SDK's role or shared-file provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Uncomment when using temporary access-key credentials:
# AWS_SESSION_TOKEN=

# IBM COS IAM, when LLMDV_S3_AUTH=ibm-iam. Use decoded values, not Kubernetes base64 data.
# Alternatively, map an existing IBM storage Secret with secretKeyRef; see README.md.
# IBM_COS_API_KEY=
# IBM_COS_SERVICE_INSTANCE_ID=

# Slack incoming webhook. Empty or absent means no notification.
LLMDV_NOTIFY_WEBHOOK=

# If the tested endpoint requires authentication, set the variable named in auth.key_env.
# This credential is required to test that endpoint; it is not an optional delivery setting.
# INFERENCE_API_KEY=
